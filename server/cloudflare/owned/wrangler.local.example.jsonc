{
  "name": "harbour-shift-local",
  "main": "build/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "vars": {
    "HARBOUR_BLIND_ORDERS": "0",
    "HARBOUR_EXTENDED_VEHICLES": "1",
    "HARBOUR_ADVANCED_RULES": "1",
    "HARBOUR_PRO_TRIAL": "1"
  },
  "durable_objects": {
    "bindings": [{ "name": "HARBOUR_COMPUTE", "class_name": "HarbourCompute" }]
  },
  "migrations": [{ "tag": "v1-harbour-compute", "new_sqlite_classes": ["HarbourCompute"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "harbour-shift-local",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "schema"
  }]
}
