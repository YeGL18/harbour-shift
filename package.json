{
  "name": "harbour-shift",
  "version": "0.8.2",
  "main": "index.ts",
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-asset": "58.0.21",
    "expo-file-system": "58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/game/*.test.ts src/audio/*.test.ts src/data/*.test.ts src/i18n/*.test.ts src/multiplayer/*.test.ts src/ui/*.test.ts src/profile/*.test.ts server/*.test.ts && node --import tsx scripts/test-multiplayer-provider.cjs",
    "export:ios": "expo export --platform ios",
    "postinstall": "node scripts/patch-maplibre-android.cjs"
  },
  "private": true
}
